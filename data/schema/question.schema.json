{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "question.schema.json",
  "title": "Boxenfunk-Fragendatei",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "question": {
      "type": "object",
      "required": ["id", "type", "category", "difficulty", "tags", "question", "explanation", "source", "generated", "lastVerified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "type": { "enum": ["mc", "tf", "estimate", "image", "order"] },
        "category": { "type": "string", "description": "id aus data/categories.json" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100, "description": "Bezugsjahr für den Zeitraum-Filter; weglassen = zeitlos" },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true, "description": "\"spass\" markiert Spaßfragen (Bwoah-Modus)" },
        "question": { "type": "string", "minLength": 5 },
        "image": {
          "type": "object",
          "required": ["url", "license", "author", "source"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1, "description": "relativ zu public/ oder absolute https-URL" },
            "license": { "type": "string", "minLength": 1 },
            "author": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2, "maxItems": 6, "uniqueItems": true },
        "items": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 3, "maxItems": 6, "uniqueItems": true, "description": "nur type=order: Elemente in der RICHTIGEN Reihenfolge" },
        "answer": { "description": "mc/image: Index der richtigen Option · tf: true/false · estimate: Zahl" },
        "accept": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "zusätzlich akzeptierte Freitext-Antworten" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0, "description": "nur estimate: Abweichung, ab der es 0 Punkte gibt" },
        "unit": { "type": "string" },
        "explanation": { "type": "string", "minLength": 5 },
        "source": { "type": "string", "minLength": 1, "description": "\"kuratiert\" oder Quelle/URL der Daten" },
        "generated": { "type": "boolean" },
        "validFrom": { "$ref": "#/definitions/date" },
        "validUntil": { "$ref": "#/definitions/date" },
        "lastVerified": { "$ref": "#/definitions/date" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["mc", "image"] } } }, "then": { "required": ["options", "answer"], "properties": { "answer": { "type": "integer", "minimum": 0 } } } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["image"] } },
        { "if": { "properties": { "type": { "const": "tf" } } }, "then": { "required": ["answer"], "properties": { "answer": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "estimate" } } }, "then": { "required": ["answer", "tolerance"], "properties": { "answer": { "type": "number" } } } },
        { "if": { "properties": { "type": { "const": "order" } } }, "then": { "required": ["items"] } }
      ]
    }
  }
}
