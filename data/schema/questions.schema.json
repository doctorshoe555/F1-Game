{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boxenfunk Fragendatei",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "category": { "type": "string", "description": "Standard-Kategorie (id aus data/categories.json) für alle Fragen der Datei" },
    "source": { "type": "string", "description": "Herkunft, z. B. Name des Generator-Skripts" },
    "generated": { "type": "string" },
    "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } }
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": ["id", "type", "difficulty", "question", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "enum": ["mc", "tf", "estimate", "image", "order"] },
        "category": { "type": "string" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100, "description": "Jahr, auf das sich die Frage bezieht (für den Zeitraum-Filter). Weglassen = zeitlos." },
        "fun": { "type": "boolean", "description": "Spaßfrage – wird im Bwoah-Modus bevorzugt" },
        "question": { "type": "string", "minLength": 5 },
        "image": { "type": "string", "description": "Pfad relativ zur Projektwurzel; Pflicht bei type=image" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 6 },
        "answer": { "description": "mc/image: Index der richtigen Option · tf: true/false · estimate: Zahl" },
        "accept": { "type": "array", "items": { "type": "string" }, "description": "Zusätzlich akzeptierte Freitext-Antworten" },
        "tolerance": { "type": "number", "exclusiveMinimum": 0, "description": "estimate: Abweichung, ab der es 0 Punkte gibt" },
        "unit": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 6, "description": "order: Elemente in der RICHTIGEN Reihenfolge" },
        "explanation": { "type": "string", "minLength": 5 }
      },
      "additionalProperties": false
    }
  }
}
